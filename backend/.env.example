DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_campus?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# Optional tuning
# CAMPUS_TZ="Asia/Kolkata"      # time zone used for "today" (attendance cannot be marked for future dates)
# LOGIN_RATE_LIMIT=30           # login attempts per 15 minutes per IP
# UPLOAD_RATE_LIMIT=60          # uploads per 15 minutes per IP
# NODE_ENV=production           # refuses to start with a weak JWT_SECRET
